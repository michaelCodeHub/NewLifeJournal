{
  "firestore": {
    "database": "(default)",
    "location": "nam5",
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "hosting": {
    "public": "legal-site",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "check-placeholders.js"
    ],
    "cleanUrls": true,
    "trailingSlash": false,
    "predeploy": [
      "node \"$PROJECT_DIR/legal-site/check-placeholders.js\""
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          {
            "key": "X-Content-Type-Options",
            "value": "nosniff"
          },
          {
            "key": "Referrer-Policy",
            "value": "strict-origin-when-cross-origin"
          }
        ]
      }
    ]
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "*.local"
      ],
      "predeploy": [
        "npm --prefix \"$RESOURCE_DIR\" run build"
      ]
    }
  ],
  "emulators": {
    "auth": {
      "port": 9099,
      "host": "0.0.0.0"
    },
    "firestore": {
      "port": 8080,
      "host": "0.0.0.0"
    },
    "storage": {
      "port": 9199,
      "host": "0.0.0.0"
    },
    "functions": {
      "port": 5001,
      "host": "0.0.0.0"
    },
    "ui": {
      "enabled": true,
      "port": 4000,
      "host": "0.0.0.0"
    },
    "singleProjectMode": true
  },
  "react-native": {
    "analytics_auto_collection_enabled": false,
    "crashlytics_debug_enabled": false,
    "crashlytics_auto_collection_enabled": false,
    "perf_auto_collect_enabled": false,
    "google_analytics_default_allow_ad_personalization_signals": false,
    "google_analytics_adid_collection_enabled": false
  }
}
